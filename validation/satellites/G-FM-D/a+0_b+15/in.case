# generated by validation/satellites/run_sat.py
seed 12345
dimension 3
global gridcut 0.0 comm/sort yes
global surfmax 1000
boundary o o o
create_box -3.117 2.7954999999999997 -1.35 1.35 -1.518 1.518
create_grid 30 14 15
balance_grid rcb cell
global nrho 1000000000000.0 fnum 48465945.0
species case.species O N2
mixture gas O N2 vstream -7437.628862425826 -1992.9066472894096 -0.0 temp 900.0
mixture gas O frac 0.7
mixture gas N2 frac 0.3
read_surf body.surf
surf_collide 1 diffuse 300.0 1.0
surf_modify all collide 1
collide vss gas case.vss
collide_modify vremax 100 yes rotate smooth vibrate discrete
fix in emit/face gas all
timestep 4.716297068722949e-06
stats 400
stats_style step cpu np
run 800
compute 1 surf all gas fx fy fz etot norm flow
fix 1 ave/surf all 1 400 400 c_1[*]
dump 1 surf all 400 dump.surf id f_1[1] f_1[2] f_1[3] f_1[4]
run 8000
