# generated by validation/satellites/run_sat.py
seed 12345
dimension 3
global gridcut 0.0 comm/sort yes
global surfmax 1000
boundary o o o
create_box -2.779 7.554 -1.839 1.839 -1.905 1.4844576
create_grid 16 6 6
balance_grid rcb cell
global nrho 3e+17 fnum 3354572137254750.0
species case.species O
mixture gas O vstream -7700.0 -0.0 -0.0 temp 900.0
mixture gas O frac 1.0
read_surf body.surf
surf_collide 1 diffuse 300.0 1.0
surf_modify all collide 1
collide vss gas case.vss
collide_modify vremax 100 yes rotate smooth vibrate discrete
fix in emit/face gas all
create_particles gas n 0
timestep 1.3321407452867268e-05
stats 100
stats_style step cpu np
run 400
compute 1 surf all gas fx fy fz etot norm flow
fix 1 ave/surf all 1 100 100 c_1[*]
dump 1 surf all 100 dump.surf id f_1[1] f_1[2] f_1[3] f_1[4]
run 2000
