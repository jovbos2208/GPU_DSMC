# generated by validation/sparta/run_cases.py
seed 12345
dimension 3
global gridcut 0.0 comm/sort yes
boundary o o o
create_box -0.4 0.4 -0.4 0.4 -0.4 0.4
create_grid 16 16 16
balance_grid rcb cell
global nrho 100000000000000.0 fnum 625000000.0000002
species case.species O
mixture gas O vstream -7500.0 500.0 -800.0 temp 900.0
read_surf cube.surf
surf_collide 1 cll 300.0 0.85 0.8775000000000001 0.85 0.85
surf_modify all collide 1
fix in emit/face gas all
create_particles gas n 0
timestep 1.1949558037251304e-06
stats 500
stats_style step cpu np
run 4000
compute 1 surf all gas fx fy fz etot norm flow
fix 1 ave/surf all 1 500 500 c_1[*]
compute 2 reduce sum f_1[1] f_1[2] f_1[3] f_1[4]
stats_style step cpu np c_2[1] c_2[2] c_2[3] c_2[4]
run 20000
