{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 27, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "VLEO_BUILD_TESTS": "ON",
        "Kokkos_ENABLE_SERIAL": "ON",
        "Kokkos_ENABLE_DEPRECATED_CODE_5": "OFF"
      }
    },
    {
      "name": "cpu-debug",
      "displayName": "CPU Debug (Kokkos Serial, bounds checks)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "Kokkos_ENABLE_DEBUG": "ON",
        "Kokkos_ENABLE_DEBUG_BOUNDS_CHECK": "ON",
        "VLEO_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "cpu-release",
      "displayName": "CPU Release (Kokkos OpenMP + Serial)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "Kokkos_ENABLE_OPENMP": "ON"
      }
    },
    {
      "name": "cuda",
      "displayName": "NVIDIA CUDA Release (default arch: AMPERE80 / A100)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "${sourceDir}/third_party/kokkos/bin/nvcc_wrapper",
        "Kokkos_ENABLE_CUDA": "ON",
        "Kokkos_ARCH_AMPERE80": "ON"
      }
    },
    {
      "name": "hip",
      "displayName": "AMD HIP Release (default arch: AMD_GFX942 / MI300X)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "hipcc",
        "Kokkos_ENABLE_HIP": "ON",
        "Kokkos_ENABLE_ROCTHRUST": "OFF",
        "Kokkos_ARCH_AMD_GFX942": "ON"
      }
    },
    {
      "name": "hip-gfx1100",
      "displayName": "AMD HIP Release for RDNA3 (Kokkos_ARCH_AMD_GFX1100, e.g. RX 7900 / iGPUs with HSA_OVERRIDE_GFX_VERSION=11.0.0)",
      "inherits": "hip",
      "cacheVariables": {
        "Kokkos_ARCH_AMD_GFX942": "OFF",
        "Kokkos_ARCH_AMD_GFX1100": "ON"
      }
    },
    {
      "name": "hip-gfx1101",
      "displayName": "AMD HIP Release for RDNA3 Navi 32 (Kokkos_ARCH_AMD_GFX1101, e.g. Radeon PRO W7700/W7800, RX 7700/7800)",
      "inherits": "hip",
      "cacheVariables": {
        "Kokkos_ARCH_AMD_GFX942": "OFF",
        "Kokkos_ARCH_AMD_GFX1101": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "cpu-debug", "configurePreset": "cpu-debug" },
    { "name": "cpu-release", "configurePreset": "cpu-release" },
    { "name": "cuda", "configurePreset": "cuda" },
    { "name": "hip", "configurePreset": "hip" },
    { "name": "hip-gfx1100", "configurePreset": "hip-gfx1100" },
    { "name": "hip-gfx1101", "configurePreset": "hip-gfx1101" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    { "name": "cpu-debug", "inherits": "base", "configurePreset": "cpu-debug" },
    { "name": "cpu-release", "inherits": "base", "configurePreset": "cpu-release",
      "environment": { "OMP_PROC_BIND": "spread", "OMP_PLACES": "threads" } },
    { "name": "cuda", "inherits": "base", "configurePreset": "cuda" },
    { "name": "hip", "inherits": "base", "configurePreset": "hip" },
    { "name": "hip-gfx1100", "inherits": "base", "configurePreset": "hip-gfx1100" },
    { "name": "hip-gfx1101", "inherits": "base", "configurePreset": "hip-gfx1101" }
  ]
}
